# Supabase Configuration
# Obtain these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Service Role Secret (Server-side only, never expose to client bundles)
# Used for initial owner bootstrap, administrative migrations, and automated tests
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (for running migrations or direct script tests)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Application Settings
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_WORKSPACE_NAME="OMG Creative Workspace"
